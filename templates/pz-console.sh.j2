#!/usr/bin/env bash
set -euo pipefail

session="pz-{{ pz_server_name }}"
command="${1:?Usage: pz-console <server-command>}"

if ! runuser -u "{{ pz_user }}" -- screen -ls | grep -Fq ".$session"; then
    printf 'Project Zomboid screen session "%s" is not running.\n' "$session" >&2
    exit 1
fi

runuser -u "{{ pz_user }}" -- screen -S "$session" -X stuff "$command"$'\r'
