#!/usr/bin/env bash
set -Eeuo pipefail

service=project-zomboid
lock_file="/run/lock/pz-{{ pz_server_name }}-maintenance.lock"
manifest="{{ pz_install_dir }}/steamapps/appmanifest_{{ pz_app_id }}.acf"
run_now=0
skip_version_check=0
while (( $# > 0 )); do
    case "$1" in
        --now)
            run_now=1
            ;;
        --skip-version-check)
            skip_version_check=1
            ;;
        *)
            printf 'Usage: %s [--now] [--skip-version-check]\n' "$0" >&2
            exit 2
            ;;
    esac
    shift
done
steamcmd_output=
restart_server=0
maintenance_started_at=$(date --iso-8601=seconds)
maintenance_started_epoch=$(date +%s)

printf 'Maintenance started at %s.\n' "$maintenance_started_at"

finish() {
    local status=$?
    local finished_at
    local finished_epoch

    if [[ -n "$steamcmd_output" ]]; then
        rm -f "$steamcmd_output"
    fi
    if (( restart_server )); then
        printf 'Maintenance failed; attempting to start Project Zomboid again.\n' >&2
        systemctl start "$service" || printf 'Could not restart Project Zomboid; check systemd logs.\n' >&2
    fi
    finished_at=$(date --iso-8601=seconds)
    finished_epoch=$(date +%s)
    printf 'Maintenance finished at %s (elapsed: %s seconds, exit status: %s).\n' \
        "$finished_at" "$(( finished_epoch - maintenance_started_epoch ))" "$status"
    exit "$status"
}
trap finish EXIT

exec 9>"$lock_file"
if ! flock -n 9; then
    printf 'Another Project Zomboid maintenance run is already in progress.\n' >&2
    exit 1
fi

if ! systemctl is-active --quiet "$service"; then
    printf 'Project Zomboid is not active; refusing to run maintenance.\n' >&2
    exit 1
fi

if (( skip_version_check )); then
    printf 'Skipping the Project Zomboid version check as requested.\n'
else
    if [[ ! -r "$manifest" ]]; then
        printf 'Cannot read installed Steam manifest %s; refusing to stop the server.\n' "$manifest" >&2
        exit 1
    fi

    installed_build_id=$(awk '$1 == "\"buildid\"" { gsub(/"/, "", $2); print $2; exit }' "$manifest")
    if [[ ! "$installed_build_id" =~ ^[0-9]+$ ]]; then
        printf 'Cannot determine the installed Project Zomboid build ID; refusing to stop the server.\n' >&2
        exit 1
    fi

    steamcmd_output=$(mktemp)
    if ! runuser -u "{{ pz_user }}" -- env HOME="{{ pz_home }}" \
        "{{ pz_steamcmd_path }}" \
        +login anonymous \
        +app_info_update 1 \
        +app_info_print "{{ pz_app_id }}" \
        +quit >"$steamcmd_output" 2>&1; then
        printf 'Could not query the latest Project Zomboid build; refusing to stop the server.\n' >&2
        tail -n 40 "$steamcmd_output" >&2
        exit 1
    fi

    if ! remote_build_id=$(python3 - "$steamcmd_output" <<'PY'
import json
import re
import sys

text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
tokens = [
    json.loads(match.group(0))
    if match.group(0).startswith('"')
    else match.group(0)
    for match in re.finditer(r'"(?:\\.|[^"\\])*"|[{}]', text)
]


def parse_object(index):
    result = {}
    while index < len(tokens):
        key = tokens[index]
        index += 1
        if key == "}":
            return result, index
        if index >= len(tokens):
            break
        if tokens[index] == "{":
            result[key], index = parse_object(index + 1)
        else:
            result[key] = tokens[index]
            index += 1
    raise ValueError("incomplete Steam app info")


for index in range(len(tokens) - 1):
    if tokens[index] == "branches" and tokens[index + 1] == "{":
        branches, _ = parse_object(index + 2)
        build_id = branches.get("public", {}).get("buildid")
        if isinstance(build_id, str) and build_id.isdecimal():
            print(build_id)
            break
else:
    raise ValueError("public build ID not found in Steam app info")
PY
    ); then
        printf 'Could not determine the latest public Project Zomboid build; refusing to stop the server.\n' >&2
        tail -n 40 "$steamcmd_output" >&2
        exit 1
    fi

    if (( 10#$remote_build_id <= 10#$installed_build_id )); then
        printf 'No newer public Project Zomboid build is available (installed %s, latest %s); skipping maintenance.\n' \
            "$installed_build_id" "$remote_build_id"
        exit 0
    fi

    printf 'Project Zomboid update found (installed build %s, latest public build %s).\n' \
        "$installed_build_id" "$remote_build_id"
fi

if (( run_now )); then
    printf 'Running maintenance immediately without notifying players or waiting for the countdown.\n'
else
    notification_output=
    if ! notification_output=$("{{ pz_console_script }}" servermsg \
        "O servidor será atualizado e reiniciado em 5 minutos." 2>&1); then
        printf 'Could not notify players; refusing to stop the server.\n%s\n' \
            "$notification_output" >&2
        exit 1
    fi
    printf '%s\n' "$notification_output"
    if [[ "$notification_output" != *"Message sent."* ]]; then
        printf 'Server did not confirm the maintenance notification; refusing to stop the server.\n' >&2
        exit 1
    fi

    printf 'Waiting 5 minutes before saving and stopping the server.\n'
    sleep 300
fi

"{{ pz_console_script }}" save
sleep {{ pz_save_wait_seconds | int }}

systemctl stop "$service"
restart_server=1

runuser -u "{{ pz_user }}" -- env HOME="{{ pz_home }}" \
    "{{ pz_steamcmd_path }}" \
    +force_install_dir "{{ pz_install_dir }}" \
    +login anonymous \
    +app_update "{{ pz_app_id }}" validate \
    +quit

systemctl start "$service"
restart_server=0
printf 'Project Zomboid save, update and restart completed successfully.\n'
